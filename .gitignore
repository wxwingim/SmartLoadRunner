# ============================================================
# SmartLoadRunner — .gitignore
# ============================================================

# ------------------------------------------------------------
# Go: бинарники и артефакты сборки
# ------------------------------------------------------------
# Скомпилированные бинарники
*.exe
*.exe~
*.dll
*.so
*.dylib
*.out

# Бинарники, собранные `go build` в корне проекта
/smart_load_runner
/coordinator
/runner

# Каталог для инструментов разработки (создаётся Taskfile.yaml)
/bin/

# ------------------------------------------------------------
# Go: тесты и покрытие
# ------------------------------------------------------------
# Тестовые бинарники (`go test -c`)
*.test
*.test.exe

# Профили покрытия и артефакты тестов
coverage.*
*.coverprofile
profile.cov
*.prof
*.pprof

# ------------------------------------------------------------
# Go: модули и зависимости
# ------------------------------------------------------------
# Go workspace (если используется)
go.work
go.work.sum

# Локальный кэш модулей (если vendor не используется)
# vendor/

# ------------------------------------------------------------
# Окружение и секреты
# ------------------------------------------------------------
# Файлы окружения — НИКОГДА не коммитить реальные секреты
.env
.env.*
!.env.example
!.env.test

# Локальные конфиги, не предназначенные для репозитория
*.local
*.local.yaml
*.local.yml
*.local.json
*.local.toml

# ------------------------------------------------------------
# Базы данных и миграции
# ------------------------------------------------------------
# Локальные файлы БД (SQLite и т.п.)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ------------------------------------------------------------
# Docker / Kubernetes
# ------------------------------------------------------------
# Локальные артефакты Docker
docker-compose.override.yml
docker-compose.override.yaml

# Kubernetes: локальные манифесты с секретами
kubeconfig
*.kubeconfig

# ------------------------------------------------------------
# Логи и временные файлы
# ------------------------------------------------------------
# Логи
*.log
logs/
*.log.*

# Временные файлы
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store

# ------------------------------------------------------------
# IDE и редакторы
# ------------------------------------------------------------
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# GoLand / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Vim / Neovim
.vim/
*.swp
*.swo

# Emacs
*~
.\#*

# ------------------------------------------------------------
# Операционные системы
# ------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------------------------
# Инструменты разработки
# ------------------------------------------------------------
# golangci-lint кэш
.golangci-cache/

# gofumpt / gci / прочие утилиты (устанавливаются в bin/)
# (уже покрыто /bin/ выше)

# ------------------------------------------------------------
# Документация и артефакты генерации
# ------------------------------------------------------------
# Сгенерированные файлы (если не нужны в репозитории)
*.gen.go
*.pb.go
*.pb.gw.go

# ------------------------------------------------------------
# Runtime-данные приложения
# ------------------------------------------------------------
# data/ — файловое хранилище координатора (создаётся и пишется во время работы):
# тесты (data/tests/*.yaml), запуски (data/runs/*.json), метрики (data/runs/*.jsonl).
# Это runtime-состояние, как база данных: не коммитим, сохраняем только структуру
# через пустой data/.gitkeep (папки пересоздаются сами в store.NewPersistence).
/data/*
!/data/.gitkeep

# ------------------------------------------------------------
# Скрипты и утилиты
# ------------------------------------------------------------
# Локальные скрипты, не предназначенные для коммита
scripts/*.local.sh
scripts/*.tmp.sh