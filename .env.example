# ============================================================
# SmartLoadRunner — шаблон конфигурации окружения
# Скопируйте в .env и заполните под свою среду.
#   cp .env.example .env
#
# Значения по умолчанию совпадают с internal/config/config.go
# ============================================================

# ------------------------------------------------------------
# Приложение
# ------------------------------------------------------------
SLR_ENVIRONMENT=development
SLR_APP_NAME=smart-load-runner
SLR_APP_VERSION=dev

# ------------------------------------------------------------
# Логирование
# ------------------------------------------------------------
SLR_LOG_LEVEL=info              # debug | info | warn | error
SLR_LOG_FORMAT=console          # console | json

# ------------------------------------------------------------
# HTTP API (coordinator)
# ------------------------------------------------------------
SLR_HTTP_HOST=0.0.0.0
SLR_HTTP_PORT=8080
SLR_HTTP_READ_TIMEOUT_SEC=15
SLR_HTTP_WRITE_TIMEOUT_SEC=30
SLR_HTTP_IDLE_TIMEOUT_SEC=60

# ------------------------------------------------------------
# PostgreSQL (coordinator)
# ------------------------------------------------------------
SLR_DB_HOST=localhost
SLR_DB_PORT=5432
SLR_DB_USER=slr
SLR_DB_PASSWORD=slr
SLR_DB_NAME=slr
SLR_DB_SSLMODE=disable
SLR_DB_MAX_OPEN_CONNS=10
SLR_DB_MAX_IDLE_CONNS=5
SLR_DB_CONN_MAX_LIFETIME_MIN=30

# ------------------------------------------------------------
# Redis (очереди и кеш — задел)
# ------------------------------------------------------------
SLR_REDIS_HOST=localhost
SLR_REDIS_PORT=6379
SLR_REDIS_PASSWORD=
SLR_REDIS_DB=0

# ------------------------------------------------------------
# Runner (воркер нагрузки)
# ------------------------------------------------------------
SLR_RUNNER_LISTEN_ADDR=:9090
SLR_RUNNER_COORDINATOR_ADDR=localhost:8080
SLR_RUNNER_CAPACITY=1000
SLR_RUNNER_REPORT_INTERVAL_SEC=1
# SLR_RUNNER_SCENARIO_FILE=./examples/scenario.yaml